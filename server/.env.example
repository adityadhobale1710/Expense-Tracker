# Core Server Configuration
NODE_ENV=production
PORT=5000
MONGO_URI=<MongoDB Atlas connection string with database name>

# Security & Authentication Tokens
JWT_SECRET=<secure random secret: openssl rand -hex 32>
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=<secure random secret>
JWT_REFRESH_EXPIRE=7d
COOKIE_SECRET=<secure random secret>
CLIENT_URL=<Frontend URL e.g. http://localhost:5173>

# NOTE: The server refuses to start if JWT_SECRET/JWT_REFRESH_SECRET/COOKIE_SECRET
# are missing, shorter than 16 chars, or match any publicly-known default.
# Stack traces are NEVER returned over the API. To expose them during local
# debugging set EXPOSE_ERROR_STACK=true (this is ignored in production):
# EXPOSE_ERROR_STACK=true

# Rate limit tuning (strong safe defaults apply everywhere):
# GLOBAL_RATE_LIMIT=300     # per IP / 15 min across /api
# LOGIN_RATE_LIMIT=5        # per IP / 15 min
# OTP_RATE_LIMIT=5          # per IP / 10 min

# ─────────────────────────────────────────────────────────────────────────────
# Email Delivery Options (Provide Option 1 OR Option 2)
# ─────────────────────────────────────────────────────────────────────────────
# OPTION 1: SMTP / Gmail App Password (RECOMMENDED — Never expires after 7 days)
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=expensetracker1710@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# SMTP_FROM=expensetracker1710@gmail.com
# SMTP_FROM_NAME=Expense Tracker

# OPTION 2: Gmail API OAuth2 (Alternative)
# NOTE: In Google Cloud Console, ensure OAuth Consent Screen status is set to "In production"
# (Publish App), otherwise Google expires refresh tokens after 7 days (invalid_grant)!
# Run `node gmail-auth.cjs` locally to obtain GMAIL_REFRESH_TOKEN.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=

# AI Assistant Gemini API Config
GEMINI_API_KEY=<your Gemini API key>
GEMINI_MODEL=gemini-3.5-flash-lite

# AI Assistant Limits & Caching
AI_DAILY_MESSAGE_LIMIT=50
AI_CACHE_TTL=120000 # Cache expiration in milliseconds (default 2 mins)

# Google OAuth Configuration (used by Google Login button — DO NOT confuse with Gmail sending)
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
