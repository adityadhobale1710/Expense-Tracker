# Core Server Configuration
NODE_ENV=production
PORT=5000
MONGO_URI=<MongoDB Atlas connection string with database name>

# Security & Authentication Tokens
JWT_SECRET=<secure random secret: openssl rand -hex 32>
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=<secure random secret>
JWT_REFRESH_EXPIRE=7d
COOKIE_SECRET=<secure random secret>
CLIENT_URL=<Frontend URL e.g. http://localhost:5173>

# NOTE: The server refuses to start if JWT_SECRET/JWT_REFRESH_SECRET/COOKIE_SECRET
# are missing, shorter than 16 chars, or match any publicly-known default.
# Stack traces are NEVER returned over the API. To expose them during local
# debugging set EXPOSE_ERROR_STACK=true (this is ignored in production):
# EXPOSE_ERROR_STACK=true

# Rate limit tuning (strong safe defaults apply everywhere):
# GLOBAL_RATE_LIMIT=300     # per IP / 15 min across /api
# LOGIN_RATE_LIMIT=5        # per IP / 15 min
# OTP_RATE_LIMIT=5          # per IP / 10 min

# Optional: Real SMTP Email Delivery (Console logging fallback is used if omitted)
# SMTP_HOST=<SMTP host>
# SMTP_PORT=<SMTP port e.g. 587 or 2525>
# SMTP_USER=<SMTP username>
# SMTP_PASS=<SMTP password>
# SMTP_FROM=<sender email>
# SMTP_FROM_NAME=<application name>
# AI Assistant Gemini API Config (e.g. use gemini-3.5-flash-lite or gemini-3.6-flash)
GEMINI_API_KEY=<your Gemini API key>
GEMINI_MODEL=gemini-3.5-flash-lite

# AI Assistant Limits & Caching
AI_DAILY_MESSAGE_LIMIT=50
AI_CACHE_TTL=120000 # Cache expiration in milliseconds (default 2 mins)

# Google OAuth Configuration (used by Google Login — DO NOT use for Gmail sending)
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Gmail API Email Sending (separate from Google Login above)
# Run server/gmail-auth.cjs locally to obtain GMAIL_REFRESH_TOKEN.
# These credentials are for the application's dedicated sender account only.
# Expense Tracker users are never asked to authorize Gmail.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
